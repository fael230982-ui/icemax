generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  dispatcher
  supervisor
  technician
  outsourced_technician
  customer
}

enum ServiceOrderStatus {
  draft
  open
  scheduled
  en_route
  in_progress
  waiting_approval
  completed
  cancelled
}

enum ServiceOrderPriority {
  low
  normal
  high
  emergency
}

enum QuoteStatus {
  draft
  sent
  approved
  rejected
  expired
  cancelled
}

enum NotificationChannel {
  email
  whatsapp
  push
  internal
}

model Tenant {
  id                      String   @id @default(uuid())
  name                    String
  legalName               String?
  document                String?
  logoUrl                 String?
  primaryColor            String   @default("#0B7CEB")
  secondaryColor          String   @default("#28D8FF")
  supportEmail            String?
  reportEmail             String?
  sendCustomerCopyDefault Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users      User[]
  customers  Customer[]
  addresses  CustomerAddress[]
  equipment  Equipment[]
  orders     ServiceOrder[]
  parts      Part[]
  locations  TechnicianLocation[]
  contracts  ServiceContract[]
  floorPlans FloorPlan[]
  qrLabels   EquipmentQrLabel[]
  checklistTemplates ChecklistTemplate[]
  partsUsed  ServiceOrderPart[]
  stockLocations StockLocation[]
  stockMovements StockMovement[]
  stockReservations StockReservation[]
  manuals    Manual[]
  quotes     Quote[]
  notifications Notification[]
  notificationTemplates NotificationTemplate[]
  whatsappEvents WhatsappEvent[]
  integrations IntegrationSetting[]
  auditLogs  AuditLog[]
  aiRequests AiRequest[]
  publicAccessTokens PublicAccessToken[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  assignedOrders ServiceOrder[] @relation("AssignedTechnician")
  openedOrders   ServiceOrder[] @relation("OpenedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  addresses CustomerAddress[]
  equipment Equipment[]
  orders    ServiceOrder[]
  contracts ServiceContract[]
  floorPlans FloorPlan[]

  @@index([tenantId, name])
}

model CustomerAddress {
  id         String  @id @default(uuid())
  tenantId   String
  customerId String
  label      String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zipCode    String?
  latitude   Decimal?
  longitude  Decimal?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  equipment Equipment[]
  orders    ServiceOrder[]
  contracts ServiceContract[]
  floorPlans FloorPlan[]

  @@index([tenantId, customerId])
}

model Equipment {
  id                   String   @id @default(uuid())
  tenantId             String
  customerId           String
  addressId            String?
  type                 String
  brand                String?
  model                String?
  serialNumber         String?
  capacityBtu          Int?
  installationLocation String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  address  CustomerAddress? @relation(fields: [addressId], references: [id])
  orders   ServiceOrder[]
  contractLinks ServiceContractEquipment[]
  mapPoints EquipmentMapPoint[]
  qrLabels  EquipmentQrLabel[]

  @@index([tenantId, customerId])
}

model FloorPlan {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  addressId  String?
  name       String
  fileUrl    String?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  address  CustomerAddress? @relation(fields: [addressId], references: [id])
  points   EquipmentMapPoint[]

  @@index([tenantId, customerId])
}

model EquipmentMapPoint {
  id          String   @id @default(uuid())
  tenantId    String
  floorPlanId String
  equipmentId String
  xPosition   Decimal
  yPosition   Decimal
  label       String?
  createdAt   DateTime @default(now())

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([tenantId, floorPlanId])
  @@unique([floorPlanId, equipmentId])
}

model EquipmentQrLabel {
  id          String    @id @default(uuid())
  tenantId    String
  equipmentId String
  code        String
  labelUrl    String?
  qrPayload   String
  printedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, equipmentId])
}

model ServiceOrder {
  id                   String               @id @default(uuid())
  tenantId             String
  customerId           String
  equipmentId          String?
  addressId            String?
  assignedTechnicianId String?
  openedByUserId       String?
  title                String
  description          String?
  priority             ServiceOrderPriority @default(normal)
  status               ServiceOrderStatus   @default(open)
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  startedAt            DateTime?
  arrivedAt            DateTime?
  completedAt          DateTime?
  customerSignatureUrl String?
  customerSignedName   String?
  reportPdfUrl         String?
  sendCopyToCustomer   Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant             Tenant @relation(fields: [tenantId], references: [id])
  customer           Customer @relation(fields: [customerId], references: [id])
  equipment          Equipment? @relation(fields: [equipmentId], references: [id])
  address            CustomerAddress? @relation(fields: [addressId], references: [id])
  assignedTechnician User? @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  openedBy           User? @relation("OpenedBy", fields: [openedByUserId], references: [id])
  notes              ServiceOrderNote[]
  photos             ServiceOrderPhoto[]
  locations          TechnicianLocation[]
  contractVisits     ServiceContractVisit[]
  checklistAnswers   ServiceOrderChecklistAnswer[]
  partsUsed          ServiceOrderPart[]
  quotes             Quote[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledStart])
  @@index([tenantId, assignedTechnicianId])
}

model ServiceContract {
  id                 String   @id @default(uuid())
  tenantId           String
  customerId         String
  addressId          String?
  name               String
  recurrenceMonths   Int
  startDate          DateTime
  endDate            DateTime?
  active             Boolean  @default(true)
  includesPreventive Boolean  @default(true)
  includesCleaning   Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  address   CustomerAddress? @relation(fields: [addressId], references: [id])
  equipment ServiceContractEquipment[]
  visits    ServiceContractVisit[]

  @@index([tenantId, active])
  @@index([tenantId, customerId])
}

model ServiceContractEquipment {
  id          String @id @default(uuid())
  tenantId    String
  contractId  String
  equipmentId String

  contract  ServiceContract @relation(fields: [contractId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([contractId, equipmentId])
  @@index([tenantId, contractId])
}

model ServiceContractVisit {
  id             String    @id @default(uuid())
  tenantId       String
  contractId     String
  serviceOrderId String?
  expectedDate   DateTime
  completedDate  DateTime?
  status         String    @default("planned")
  notes          String?

  contract ServiceContract @relation(fields: [contractId], references: [id])
  order    ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([tenantId, expectedDate])
  @@index([tenantId, status])
}

model ServiceOrderNote {
  id             String   @id @default(uuid())
  tenantId       String
  serviceOrderId String
  authorUserId   String?
  rawText        String?
  improvedText   String?
  aiReviewed     Boolean  @default(false)
  createdAt      DateTime @default(now())

  order ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@index([tenantId, serviceOrderId])
}

model ServiceOrderPhoto {
  id              String   @id @default(uuid())
  tenantId        String
  serviceOrderId  String
  type            String
  fileUrl         String
  caption         String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  order ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@index([tenantId, serviceOrderId])
}

model ChecklistTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  serviceType String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  items  ChecklistItem[]

  @@index([tenantId, serviceType])
}

model ChecklistItem {
  id         String  @id @default(uuid())
  tenantId   String
  templateId String
  label      String
  required   Boolean @default(false)
  inputType  String  @default("checkbox")
  sortOrder  Int     @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id])
  answers  ServiceOrderChecklistAnswer[]

  @@index([tenantId, templateId])
}

model ServiceOrderChecklistAnswer {
  id             String   @id @default(uuid())
  tenantId       String
  serviceOrderId String
  checklistItemId String
  value          String?
  createdAt      DateTime @default(now())

  order ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  item  ChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@index([tenantId, serviceOrderId])
}

model Part {
  id           String   @id @default(uuid())
  tenantId     String
  sku          String?
  name         String
  unit         String   @default("un")
  costPrice    Decimal?
  salePrice    Decimal?
  minimumStock Decimal  @default(0)
  active       Boolean  @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  stockItems StockItem[]
  stockMovements StockMovement[]
  reservations StockReservation[]
  orderParts ServiceOrderPart[]

  @@index([tenantId, name])
}

model StockLocation {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  type             String
  technicianUserId String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  stockItems StockItem[]
  movementsFrom StockMovement[] @relation("StockMovementFrom")
  movementsTo   StockMovement[] @relation("StockMovementTo")
  reservations  StockReservation[]

  @@index([tenantId, type])
}

model StockItem {
  id         String  @id @default(uuid())
  tenantId   String
  partId     String
  locationId String
  quantity   Decimal @default(0)

  part     Part @relation(fields: [partId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([partId, locationId])
  @@index([tenantId, locationId])
}

model StockMovement {
  id             String   @id @default(uuid())
  tenantId       String
  partId         String
  fromLocationId String?
  toLocationId   String?
  serviceOrderId String?
  quantity       Decimal
  reason         String
  createdByUserId String?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  part   Part @relation(fields: [partId], references: [id])
  fromLocation StockLocation? @relation("StockMovementFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation? @relation("StockMovementTo", fields: [toLocationId], references: [id])

  @@index([tenantId, partId])
  @@index([tenantId, serviceOrderId])
}

model StockReservation {
  id             String   @id @default(uuid())
  tenantId       String
  partId         String
  locationId     String
  serviceOrderId String
  quantity       Decimal
  status         String   @default("reserved")
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  part Part @relation(fields: [partId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@index([tenantId, serviceOrderId])
}

model ServiceOrderPart {
  id             String   @id @default(uuid())
  tenantId       String
  serviceOrderId String
  partId         String
  quantity       Decimal
  unitPrice      Decimal?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  part  Part @relation(fields: [partId], references: [id])

  @@index([tenantId, serviceOrderId])
}

model Quote {
  id             String      @id @default(uuid())
  tenantId       String
  serviceOrderId String
  customerId     String
  number         String
  status         QuoteStatus @default(draft)
  subtotal       Decimal     @default(0)
  discount       Decimal     @default(0)
  total          Decimal     @default(0)
  validUntil     DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  approvalToken  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  items  QuoteItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, serviceOrderId])
}

model QuoteItem {
  id          String  @id @default(uuid())
  tenantId    String
  quoteId     String
  kind        String
  description String
  quantity    Decimal @default(1)
  unitPrice   Decimal @default(0)
  total       Decimal @default(0)
  partId      String?

  quote Quote @relation(fields: [quoteId], references: [id])

  @@index([tenantId, quoteId])
}

model Manual {
  id            String   @id @default(uuid())
  tenantId      String
  title         String
  brand         String?
  model         String?
  equipmentType String?
  capacityBtu   Int?
  fileUrl       String
  tags          String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, brand, model])
}

model AiRequest {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String?
  serviceOrderId String?
  type           String
  inputText      String?
  outputText     String?
  imageUrl       String?
  model          String?
  estimatedCost  Decimal?
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, type])
  @@index([tenantId, serviceOrderId])
}

model Notification {
  id          String              @id @default(uuid())
  tenantId    String
  channel     NotificationChannel
  recipient   String
  subject     String?
  body        String?
  status      String              @default("pending")
  relatedType String?
  relatedId   String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, relatedType, relatedId])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  tenantId  String
  channel   NotificationChannel
  name      String
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, name])
  @@index([tenantId, active])
}

model WhatsappEvent {
  id          String   @id @default(uuid())
  tenantId    String
  phoneNumberId String?
  messageId   String?
  direction   String
  fromNumber  String?
  toNumber    String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, messageId])
  @@index([tenantId, createdAt])
}

model IntegrationSetting {
  id        String   @id @default(uuid())
  tenantId  String
  provider  String
  status    String   @default("not_configured")
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId, status])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

model PublicAccessToken {
  id             String    @id @default(uuid())
  tenantId       String
  tokenHash      String
  scope          String
  entityType     String
  entityId       String
  customerId     String?
  customerEmail  String?
  customerPhone  String?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  metadata       Json?
  createdByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tokenHash])
  @@index([tenantId, scope, entityType, entityId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, customerId])
}

model TechnicianLocation {
  id                String   @id @default(uuid())
  tenantId          String
  technicianUserId  String
  serviceOrderId    String?
  latitude          Decimal
  longitude         Decimal
  accuracy          Decimal?
  capturedAt        DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([tenantId, technicianUserId, capturedAt])
}
